# ----------------------------------------------------------------------
# Mentry Solutions - Production & Local Environment Configuration
# ----------------------------------------------------------------------

# Environment Mode: production | development
APP_ENV="production"

# Application Base URL (Canonical HTTPS Domain in Production)
APP_URL="https://mentry.solutions"
NEXT_PUBLIC_APP_URL="https://mentry.solutions"

# Security & Session Authentication Secret
JWT_SECRET="mentry-solutions-secure-secret-key-production"

# Administrative & Support Contacts
ADMIN_EMAIL="admin@mentry.test"
CONTACT_EMAIL="mentry.training@gmail.com"

# Supabase Cloud Database & Storage
SUPABASE_URL="https://yourproject.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_HOST="db.yourproject.supabase.co"
SUPABASE_PORT="5432"
SUPABASE_USER="postgres"
SUPABASE_DATABASE="postgres"
SUPABASE_DB_PASS="your-db-password"

# SMTP Mailer Settings (Google App Password / Enterprise SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM_NAME="Mentry"
SMTP_FROM_EMAIL="your-email@gmail.com"

# Google Gemini AI Matching Engine
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
