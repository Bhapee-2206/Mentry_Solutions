{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{public/**,includes/**,admin/**,trainer/**,actions/**,vendor/**,*.png,*.ico,*.php}"
    }
  },
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/mentry.png",
      "dest": "/api/index.php"
    },
    {
      "src": "/favicon.ico",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
